{
  "name": "huizhou-weekly-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:generate": "node scripts/generate-placeholder-assets.mjs",
    "validate:dimensions": "tsx scripts/asset-dimension-validator.ts",
    "validate:content": "tsx scripts/content-validator.ts",
    "validate:licenses": "tsx scripts/asset-license-validator.ts",
    "audit": "tsx scripts/project-audit.ts",
    "build:astro": "astro build",
    "build": "pnpm run audit && pnpm run validate:dimensions && pnpm run validate:content && pnpm run validate:licenses && astro build && pagefind --site dist",
    "preview": "astro preview",
    "preview:static": "node scripts/preview-static.mjs"
  },
  "dependencies": {
    "astro": "7.1.3",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "photoswipe": "^5.4.4",
    "sharp": "^0.34.5",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@types/node": "^24.10.0",
    "pagefind": "^1.5.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
