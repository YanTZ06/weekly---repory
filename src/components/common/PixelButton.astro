---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "red";
  external?: boolean;
  label?: string;
}

const { href, variant = "primary", external = false, label } = Astro.props;
---

<a
  class:list={["pixel-button", variant !== "primary" && variant]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  aria-label={label}
>
  <slot />
</a>
