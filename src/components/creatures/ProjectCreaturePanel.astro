---
import type { Creature, Project } from "@/types/content";
import { assetUrl } from "@/utils/paths";

interface Props {
  project: Project;
  creature: Creature;
  count: number;
  latestDate?: string;
}

const { project, creature, count, latestDate = "暂无记录" } = Astro.props;
---

<header class="project-creature-panel">
  <div class="project-creature-art">
    <img class="pixel-art" src={assetUrl(creature.largeSprite)} width="128" height="128" alt={creature.name} />
  </div>
  <div>
    <p class="eyebrow">灵兽图鉴 · {creature.element}</p>
    <h1>{project.name}</h1>
    <p class="lede">守护灵兽：{creature.name}</p>
    <div class="project-stat-row">
      <span><strong>{count}</strong> 条关联事项</span>
      <span>最近更新：<strong>{latestDate}</strong></span>
    </div>
  </div>
</header>

<style>
  .project-creature-panel {
    display: grid;
    grid-template-columns: 190px 1fr;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem;
    border: 5px solid var(--tile);
    background: linear-gradient(135deg, color-mix(in srgb, var(--water) 28%, var(--wall)), var(--wall));
    box-shadow: 9px 9px 0 var(--shadow);
  }
  .project-creature-art {
    display: grid;
    width: 170px;
    height: 170px;
    place-items: center;
    border: 5px solid var(--tile);
    border-radius: 50%;
    background: color-mix(in srgb, var(--sky) 35%, var(--paper));
  }
  .project-creature-art img { width: 128px; height: 128px; object-fit: contain; }
  .project-stat-row { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1rem; }
  .project-stat-row span { padding: 0.55rem 0.75rem; border: 3px solid var(--tile); background: var(--paper); }

  @media (max-width: 700px) {
    .project-creature-panel { grid-template-columns: 1fr; text-align: center; }
    .project-creature-art { margin: auto; }
    .project-stat-row { justify-content: center; }
  }
</style>
