---
interface Props {
  label: string;
  x: number;
  y: number;
  href: string;
}

const { label, x, y, href } = Astro.props;
---

<a class="map-hotspot" href={href} style={`left:${x}px;top:${y}px`} aria-label={label}>
  <span>{label}</span>
</a>

<style>
  .map-hotspot {
    position: absolute;
    z-index: 8;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 3px solid var(--tile);
    color: var(--ink);
    background: var(--yellow);
    text-decoration: none;
  }

  .map-hotspot span {
    position: absolute;
    left: 50%;
    bottom: 120%;
    display: none;
    width: max-content;
    max-width: 180px;
    padding: 0.4rem;
    background: var(--paper);
    translate: -50% 0;
  }

  .map-hotspot:hover span,
  .map-hotspot:focus span {
    display: block;
  }
</style>
