---
import type { Profile } from "@/types/config";
import CharacterDialog from "./CharacterDialog.astro";
import ExternalLinks from "@/components/common/ExternalLinks.astro";
import { assetUrl, withBase } from "@/utils/paths";

interface Props {
  profile: Profile;
  weeklyCount: number;
}

const { profile, weeklyCount } = Astro.props;
const positions = {
  "village-gate": [210, 505],
  "waterside-courtyard": [1970, 515],
  "academy-door": [525, 480],
  "stone-bridge": [925, 535],
  "lotus-pond": [1500, 535]
} as const;
const [x, y] = positions[profile.avatar.mapPosition];
---

<button
  class="player-avatar"
  type="button"
  style={`--x:${x}px;--y:${y}px;--avatar-scale:${profile.avatar.mapScale}`}
  data-dialog-open="profile-dialog"
  aria-label={`打开 ${profile.name} 的个人信息`}
>
  <span class="player-shadow" aria-hidden="true"></span>
  <img
    class="pixel-art"
    src={assetUrl(profile.avatar.path)}
    width={profile.avatar.nativeWidth}
    height={profile.avatar.nativeHeight}
    alt={`${profile.name} 的像素头像`}
  />
  {profile.avatar.showName && <span class="player-name">{profile.name}</span>}
</button>

<CharacterDialog id="profile-dialog" title={`村落主人 · ${profile.name}`}>
  <div class="profile-dialog-grid">
    <img
      class="pixel-art profile-dialog-avatar"
      src={assetUrl(profile.avatar.path)}
      width="128"
      height="128"
      alt={`${profile.name} 的像素头像`}
    />
    <div>
      <p>{profile.description}</p>
      <p><strong>本周记录：</strong>{weeklyCount} 条</p>
      <div class="profile-actions">
        <a class="pixel-button" href={withBase("/about/")}>进入关于页面</a>
      </div>
      <ExternalLinks links={profile.links} />
    </div>
  </div>
</CharacterDialog>

<style>
  .player-avatar {
    position: absolute;
    z-index: 7;
    left: var(--x);
    top: var(--y);
    width: calc(64px * var(--avatar-scale));
    height: calc(64px * var(--avatar-scale));
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    animation: player-idle 2.5s steps(2, jump-none) infinite;
  }

  .player-avatar img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .player-shadow {
    position: absolute;
    z-index: 1;
    right: 14%;
    bottom: 1%;
    left: 14%;
    height: 14%;
    border-radius: 50%;
    background: rgba(38, 55, 70, 0.35);
  }

  .player-name {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: -18px;
    padding: 2px 6px;
    border: 2px solid var(--tile);
    background: var(--paper);
    font-size: 0.72rem;
    font-weight: 900;
    translate: -50% 0;
  }

  .profile-dialog-grid {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }

  .profile-dialog-avatar {
    width: 128px;
    height: 128px;
    object-fit: contain;
  }

  .profile-actions {
    margin: 1rem 0;
  }

  @keyframes player-idle {
    50% { translate: 0 -2px; }
  }

  :global(:root[data-theme="night"]) .player-avatar img {
    filter: brightness(0.78) saturate(0.9);
  }

  @media (max-width: 520px) {
    .profile-dialog-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .profile-dialog-avatar {
      margin: auto;
    }
  }
</style>
