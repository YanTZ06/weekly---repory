---
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const configured = Boolean(repo && repoId && category && categoryId);
---

<section class="comments-section pixel-window" aria-labelledby="comments-title">
  <h2 id="comments-title">驿站留言</h2>
  {configured ? (
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="zh-CN"
      crossorigin="anonymous"
      async
    ></script>
  ) : (
    <p class="comments-unconfigured">评论功能尚未配置。配置 giscus 后，访客需登录 GitHub 才能评论和回复。</p>
  )}
</section>

<style>
  .comments-section {
    margin-top: 2.5rem;
  }
  .comments-section h2 {
    margin-top: 0;
  }
  .comments-unconfigured {
    margin-bottom: 0;
    color: var(--muted);
  }
</style>
