---
import type { WeeklyReport } from "@/types/content";
import CategorySection from "./CategorySection.astro";
import GiscusComments from "@/components/comments/GiscusComments.astro";
import PixelButton from "@/components/common/PixelButton.astro";
import { withBase } from "@/utils/paths";

interface Props {
  report: WeeklyReport;
  previous?: WeeklyReport;
  next?: WeeklyReport;
}

const { report, previous, next } = Astro.props;
const categories = ["science-association", "personal", "other"] as const;
---

<div class="weekly-report-page">
  <header class="report-cover">
    <div class="cover-index mono">{report.weekYear} · W{String(report.week).padStart(2, "0")}</div>
    <p class="eyebrow">成长档案</p>
    <h1>第 {report.week} 周周报</h1>
    <p>{report.startDate} — {report.endDate}</p>
    <dl class="cover-stats">
      <div><dt>事项</dt><dd>{report.items.length}</dd></div>
      <div><dt>项目</dt><dd>{report.projects.length}</dd></div>
      <div><dt>标签</dt><dd>{report.tags.length}</dd></div>
    </dl>
  </header>

  {categories.map((category) => (
    <CategorySection category={category} items={report.items.filter((item) => item.category === category)} />
  ))}

  <nav class="week-navigation" aria-label="周报翻页">
    <div>
      {previous && (
        <PixelButton href={withBase(`/reports/${previous.weekYear}/${previous.week}/`)} variant="secondary">
          ← 第 {previous.week} 周
        </PixelButton>
      )}
    </div>
    <PixelButton href={withBase("/reports/")} variant="secondary">全部周报</PixelButton>
    <div>
      {next && (
        <PixelButton href={withBase(`/reports/${next.weekYear}/${next.week}/`)} variant="secondary">
          第 {next.week} 周 →
        </PixelButton>
      )}
    </div>
  </nav>

  <GiscusComments />
</div>

<style>
  .weekly-report-page {
    width: min(calc(100% - 2rem), 900px);
    margin: 2rem auto 4rem;
  }

  .report-cover {
    position: relative;
    overflow: hidden;
    padding: 2rem;
    border: 6px solid var(--tile);
    background:
      linear-gradient(135deg, transparent 0 48%, rgba(165, 103, 63, 0.08) 49% 51%, transparent 52%),
      var(--wall);
    box-shadow: 10px 10px 0 var(--wood);
  }

  .report-cover::before,
  .report-cover::after {
    position: absolute;
    top: 0;
    width: 64px;
    height: 64px;
    content: "";
    background: var(--tile);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  .report-cover::before { left: 0; }
  .report-cover::after { right: 0; transform: scaleX(-1); }
  .report-cover h1 { margin-top: 0.5rem; }
  .cover-index { color: var(--muted); font-weight: 800; }

  .cover-stats {
    display: flex;
    gap: 1rem;
    margin: 1.5rem 0 0;
  }
  .cover-stats div {
    min-width: 86px;
    padding: 0.7rem;
    border: 3px solid var(--tile);
    background: var(--paper);
    text-align: center;
  }
  .cover-stats dt { color: var(--muted); font-size: 0.78rem; }
  .cover-stats dd { margin: 0.15rem 0 0; font: 900 1.4rem/1 ui-monospace, monospace; }

  .week-navigation {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .week-navigation > :last-child { text-align: right; }

  @media (max-width: 600px) {
    .weekly-report-page { width: min(calc(100% - 1rem), 900px); }
    .report-cover { padding: 1.3rem; }
    .cover-stats { gap: 0.5rem; }
    .cover-stats div { min-width: 0; flex: 1; }
    .week-navigation { grid-template-columns: 1fr; }
    .week-navigation > * { text-align: center !important; }
  }
</style>
