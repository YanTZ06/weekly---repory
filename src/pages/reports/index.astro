---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WeeklyReportCard from "@/components/reports/WeeklyReportCard.astro";
import EmptyState from "@/components/common/EmptyState.astro";
import { loadReportItems } from "@/utils/content";
import { aggregateWeeklyReports } from "@/utils/reports";

const reports = aggregateWeeklyReports(await loadReportItems());
const years = [...new Set(reports.map((report) => report.weekYear))].sort((a, b) => b - a);
---

<BaseLayout title="周报档案墙" description="按 ISO 周整理的个人成长档案">
  <div class="content-page">
    <header class="page-hero">
      <div>
        <p class="eyebrow">徽州书院 · 档案墙</p>
        <h1>历年周报</h1>
        <p class="lede">每条事项按作者、ISO week-year 和 ISO 周自动归入同一份档案。</p>
      </div>
      {years.length > 1 && (
        <label class="year-filter">
          <span>按年份筛选</span>
          <select data-year-filter>
            <option value="all">全部年份</option>
            {years.map((year) => <option value={year}>{year} 年</option>)}
          </select>
        </label>
      )}
    </header>

    {reports.length > 0 ? (
      <div class="report-years">
        {years.map((year) => (
          <section data-report-year={year} aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="year-heading"><span class="mono">{year}</span> 年档案</h2>
            <div class="report-list">
              {reports.filter((report) => report.weekYear === year).map((report) => <WeeklyReportCard report={report} />)}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <EmptyState title="档案墙还是空的" message="在管理小屋新增事项后，这里会自动出现周报。" />
    )}
  </div>
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLSelectElement>("[data-year-filter]");
  filter?.addEventListener("change", () => {
    document.querySelectorAll<HTMLElement>("[data-report-year]").forEach((section) => {
      section.hidden = filter.value !== "all" && section.dataset.reportYear !== filter.value;
    });
  });
</script>

<style>
  .year-filter {
    display: grid;
    gap: 0.35rem;
    font-weight: 800;
  }
  .year-filter select {
    min-width: 150px;
    min-height: 44px;
    border: 3px solid var(--tile);
    color: var(--ink);
    background: var(--paper);
  }
  .report-years {
    display: grid;
    gap: 2.5rem;
  }
  .year-heading {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0.55rem 1rem;
    border: 4px solid var(--tile);
    background: var(--wall);
    box-shadow: 5px 5px 0 var(--wood);
  }
  .report-list {
    display: grid;
    gap: 1rem;
  }
</style>
