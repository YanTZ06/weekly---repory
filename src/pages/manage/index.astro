---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ManagementConsole from "@/components/manage/ManagementConsole.astro";

const manageApiUrl = import.meta.env.PUBLIC_MANAGE_API_URL ?? "";
---

<BaseLayout title="管理小屋" description="验证 GitHub 身份后直接管理周报内容">
  <div class="content-page">
    <header class="page-hero">
      <div>
        <p class="eyebrow">村落管理小屋 · GITHUB VERIFIED</p>
        <h1>内容管理</h1>
        <p class="lede">验证 GitHub 身份后，可直接在这里填写和提交。后台通过私密请求校验内容并更新网站，不会公开表单内容。</p>
      </div>
    </header>

    <ManagementConsole apiUrl={manageApiUrl} />
  </div>
</BaseLayout>
