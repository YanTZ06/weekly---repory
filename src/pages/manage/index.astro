---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PixelWindow from "@/components/common/PixelWindow.astro";

const repo = import.meta.env.PUBLIC_GITHUB_REPO ?? "YanTZ06/weekly---repory";
const issueBase = `https://github.com/${repo}/issues/new`;
const entries = [
  { title: "新增周报事项", template: "add-report-item.yml", icon: "✎" },
  { title: "修改已有事项", template: "update-report-item.yml", icon: "↻" },
  { title: "隐藏、删除或恢复", template: "change-report-status.yml", icon: "♲" },
  { title: "新增标签", template: "add-tag.yml", icon: "#" },
  { title: "管理项目灵兽", template: "manage-project-creature.yml", icon: "✦" },
  { title: "管理记录球", template: "manage-calendar-icon.yml", icon: "●" },
  { title: "管理自定义表情", template: "manage-emoji.yml", icon: "☺" },
  { title: "更新个人资料", template: "update-profile.yml", icon: "人" }
];
---

<BaseLayout title="管理小屋" description="通过 GitHub Issue Forms 管理周报仓库内容">
  <div class="content-page">
    <header class="page-hero">
      <div>
        <p class="eyebrow">村落管理小屋 · OWNER ONLY</p>
        <h1>内容管理</h1>
        <p class="lede">管理操作将在 GitHub 中打开。工作流会验证 Issue 作者，只有仓库所有者可以修改内容。</p>
      </div>
    </header>

    <PixelWindow class="manage-notice">
      <strong>将在 GitHub 中打开</strong>
      <p>请先登录 GitHub。访客可以看到这个页面，但非所有者提交的管理 Issue 会被拒绝并自动关闭。</p>
    </PixelWindow>

    <div class="manage-grid grid grid-3">
      {entries.map((entry) => (
        <a
          class="manage-entry"
          href={`${issueBase}?template=${entry.template}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="manage-icon" aria-hidden="true">{entry.icon}</span>
          <strong>{entry.title}</strong>
          <small>将在 GitHub 中打开 ↗</small>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .manage-notice { margin-bottom: 1.5rem; border-left: 10px solid var(--red); }
  .manage-notice p { margin-bottom: 0; color: var(--muted); }
  .manage-entry {
    display: grid;
    min-height: 180px;
    place-items: center;
    padding: 1rem;
    border: 4px solid var(--tile);
    color: var(--ink);
    background: var(--white);
    box-shadow: 7px 7px 0 var(--shadow);
    text-align: center;
    text-decoration: none;
  }
  .manage-entry:hover { translate: 0 -4px; }
  .manage-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border: 3px solid var(--tile);
    background: var(--yellow);
    font-size: 1.6rem;
  }
  .manage-entry small { color: var(--muted); }
</style>
